#!/usr/bin/with-contenv bash
set -euo pipefail

settings=/config/settings.json.notification
jq \
  --arg filename /usr/local/bin/transmission-email-on-complete \
  '."script-torrent-done-enabled" = true | ."script-torrent-done-filename" = $filename' \
  /config/settings.json >"${settings}"
chown abc:abc "${settings}"
mv "${settings}" /config/settings.json
