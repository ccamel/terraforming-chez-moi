services:
  gluetun:
    image: ${transmission_vpn_image}
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      VPN_SERVICE_PROVIDER: $${TRANSMISSION_VPN_SERVICE_PROVIDER}
      VPN_TYPE: wireguard
      WIREGUARD_PRIVATE_KEY: $${TRANSMISSION_WIREGUARD_PRIVATE_KEY}
      FIREWALL_INPUT_PORTS: "9091"
      VPN_PORT_FORWARDING: "on"
      VPN_PORT_FORWARDING_PROVIDER: $${TRANSMISSION_VPN_SERVICE_PROVIDER}
      VPN_PORT_FORWARDING_UP_COMMAND: "/bin/sh /gluetun/update-transmission-port.sh {{PORT}}"
      TRANSMISSION_USERNAME: $${TRANSMISSION_USERNAME}
      TRANSMISSION_PASSWORD: $${TRANSMISSION_PASSWORD}
    volumes:
      - ./update-transmission-port.sh:/gluetun/update-transmission-port.sh:ro
    networks:
      edge_net:
        aliases:
          - transmission
    logging:
      driver: json-file

  transmission:
    image: ${transmission_image}
    container_name: transmission
    volumes:
      - ./config:/config
      - ${transmission_downloads_path}:/downloads
    environment:
      PUID: "1028"
      PGID: "100"
      TZ: Europe/Paris
      USER: $${TRANSMISSION_USERNAME}
      PASS: $${TRANSMISSION_PASSWORD}
      TRANSMISSION_MAIL_ADDRESS: $${TRANSMISSION_MAIL_ADDRESS}
      TRANSMISSION_MAIL_PASSWORD: $${TRANSMISSION_MAIL_PASSWORD}
      TRANSMISSION_NOTIFICATION_TO: $${TRANSMISSION_NOTIFICATION_TO}
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
    restart: unless-stopped
    logging:
      driver: json-file

networks:
  edge_net:
    external: true
    name: edge
