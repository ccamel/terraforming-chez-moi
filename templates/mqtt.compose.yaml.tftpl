services:
  permfix:
    image: alpine:3.22
    user: "0:0"
    volumes:
      - ./data:/fix
    command: chown 1883:1883 /fix
    restart: "no"

  mosquitto:
    image: eclipse-mosquitto:2.0.22
    container_name: mqtt
    labels:
      mqtt.config-checksum: "${mqtt_config_checksum}"
    ports:
      - "127.0.0.1:$${MQTT_PUBLISHED_PORT}:1883"
    environment:
      MQTT_HOMEASSISTANT_PASSWORD: $${MQTT_HOMEASSISTANT_PASSWORD}
    volumes:
      - ./data:/mosquitto/data
      - ./mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
    entrypoint: ["/bin/sh", "-ec"]
    command:
      - |
        printf '%s\n%s\n' "$$MQTT_HOMEASSISTANT_PASSWORD" "$$MQTT_HOMEASSISTANT_PASSWORD" | mosquitto_passwd -c /tmp/mosquitto.passwd homeassistant
        chmod 644 /tmp/mosquitto.passwd
        exec mosquitto -c /mosquitto/config/mosquitto.conf
    healthcheck:
      test: ["CMD-SHELL", "mosquitto_sub -h 127.0.0.1 -u homeassistant -P \"$$MQTT_HOMEASSISTANT_PASSWORD\" -t '$$SYS/broker/version' -C 1 -W 5 >/dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
    depends_on:
      permfix:
        condition: service_completed_successfully
    restart: unless-stopped
